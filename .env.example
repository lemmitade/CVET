# ==============================================================================
# CVET Environment Configuration Template
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Neon PostgreSQL Database
# Replace with your actual Neon connection string:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="generate_a_secure_jwt_secret_here"

# Super Admin Account Credentials
INITIAL_ADMIN_EMAIL="admin@cvet.et"
INITIAL_ADMIN_PASSWORD="ChangeThisPassword123!"

# OpenAI API Integration
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Google Drive API File Storage Integration
GOOGLE_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="1A2B3C4D5E6F7G8H9I0J"

# ATS Checker Settings
ATS_MAX_FILE_SIZE_BYTES=1048576
